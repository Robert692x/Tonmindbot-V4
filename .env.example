# ── Telegram ──────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username
ADMIN_IDS=[123456789]

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# ── Redis (optional) ──────────────────────────────────────────
REDIS_URL=

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o

# ── TON Blockchain ────────────────────────────────────────────
TON_API_KEY=your_tonapi_key_here
TON_API_BASE=https://tonapi.io
TON_WALLET=UQ...your_wallet_address

# ── Settings ──────────────────────────────────────────────────
PREMIUM_PRICE_TON=1
PREMIUM_DAYS=30
FREE_AI_REQUESTS=5
REFERRAL_BONUS_DAYS=7
WHALE_THRESHOLD_TON=10000.0

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
